# Tulanam Cloud Functions environment — copy to .env and fill in.
# See SMS_DLT_TEMPLATES.md for the exact DLT template text to register.

# OTP test bypass — leave false in production (enables the 000000 test code).
ALLOW_TEST_OTP=false

# Email (Gmail / nodemailer)
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=

# SMS — Fast2SMS
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=TULNAM        # DLT header (transactional SMS)
FAST2SMS_OTP_ID=                 # Fast2SMS OTP Template ID (OTP API)

# Transactional DLT template IDs (one registered template each)
FAST2SMS_TPL_PASSWORD_CHANGED=
FAST2SMS_TPL_SECURITY_ALERT=
FAST2SMS_TPL_GATE_ALERT=
FAST2SMS_TPL_LICENSE_EXPIRY=
FAST2SMS_TPL_LICENSE_EXPIRED=
FAST2SMS_TPL_ADDRESS_GRACE=
FAST2SMS_TPL_OPERATOR_INVITE=
FAST2SMS_TPL_CONTACT_CHANGED=
FAST2SMS_TPL_WEIGHMENT_RECEIPT=
FAST2SMS_TPL_MFA_CHANGED=
FAST2SMS_TPL_BACKUP_FAILED=
FAST2SMS_TPL_WELCOME=
FAST2SMS_TPL_LICENSE_ACTIVATED=
FAST2SMS_TPL_OPERATOR_DEACTIVATED=
FAST2SMS_TPL_KYC_RESULT=
FAST2SMS_TPL_DAILY_DIGEST=
FAST2SMS_TPL_QUOTA_REACHED=

# ─── Security / crypto (REQUIRED — functions fail closed without these) ───
# AES-256-GCM key for TOTP secrets. 64 hex chars. MFA login/disable/verify throw
# without it. Rotating it invalidates existing TOTP secrets (backup codes still
# work — they fall through the decrypt). Generate: openssl rand -hex 32
MFA_ENC_KEY=
# Signs/validates license keys (generateLicenseKey/validateLicense). Was once a
# hardcoded fallback — now fail-closed. Any long random string.
LICENSE_ADMIN_SECRET=
# HMAC secret for the public renderEmailDoc endpoint (fail-closed; constant-time
# compared). Must match the value the client/signing side uses.
RENDER_SECRET=
RENDER_URL=

# ─── Meon DigiLocker (Aadhaar KYC) ───
MEON_BASE_URL=
MEON_SECRET_TOKEN=
MEON_REDIRECT_URL=
MEON_COMPANY_NAME=

# ─── GSTIN lookup ───
GSTIN_API_KEY=

# ─── Quotas / misc ───
DEFAULT_EMAIL_MONTHLY=
DEFAULT_SMS_MONTHLY=
ERROR_DIGEST_TO=                 # recipient for the scheduled error-report digest
