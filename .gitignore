# Midjourney assets
midjourney/

# Editor/scratch backups (e.g. firestore.rules.bak, *.pbxproj.bak)
*.bak

# Python sidecar virtualenv & caches (models/ & datasets/ ignored above)
python_sidecar/venv/
python_sidecar/.venv/
**/__pycache__/

# Design-tool exports (UI mockups, not source) — large; keep on disk, off the repo
/stitch_login_login_tab_active/

# Local emulator debug log
firestore-debug.log

