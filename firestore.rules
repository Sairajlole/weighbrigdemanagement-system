rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A client (anonymous) may update operator docs (activate/verify/archive/etc.)
    // but must NOT touch security-critical fields — those are written only by the
    // server (Admin SDK bypasses rules). Blocks privilege escalation (role/isAdmin),
    // single-session bypass (activeSessionId) and PIN/uid tampering. Verified: no
    // client flow writes these on update; role/pinHash are set only at create.
    function operatorUpdateSafe() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'pinHash', 'activeSessionId', 'uid', 'isAdmin', 'isCompanyAdmin', 'mfaRequired']);
    }

    // ─── Top-level: Companies ───────────────────────────────────────
    match /companies/{companyId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;

      // ─── Company-level settings ───────────────────────────────────

      match /settings/{settingId} {
        allow read, write: if true;
      }

      // Monthly email/SMS spend counters — written ONLY by Cloud Functions
      // (Admin SDK). Client-readable so the app can show usage, but never
      // client-writable, or the cost cap could be bypassed.
      match /usage/{period} {
        allow read: if true;
        allow write: if false;
      }

      // ─── Company-wide collections ──────────────────────────────────

      match /operators/{operatorId} {
        allow read, create, delete: if true;
        allow update: if operatorUpdateSafe();
      }

      match /customers/{customerId} {
        allow read, write: if true;
      }

      match /customers_deleted/{customerId} {
        allow read, write: if true;
      }

      match /customer_merges/{mergeId} {
        allow read, write: if true;
      }

      match /materials/{materialId} {
        allow read, write: if true;
      }

      match /vehicles/{vehicleId} {
        allow read, write: if true;
      }

      match /auditLog/{logId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false;
      }

      match /notifications/{notifId} {
        allow read, write: if true;
      }

      match /training_data/{sampleId} {
        allow read, write: if true;
      }

      match /rejections/{rejectionId} {
        allow read, write: if true;
      }

      match /gstin_verifications/{verificationId} {
        allow read, write: if true;
      }

      // ─── Sites ────────────────────────────────────────────────────

      match /sites/{siteId} {
        allow read, write: if true;

        match /operators/{operatorId} {
          allow read, create, delete: if true;
          allow update: if operatorUpdateSafe();
        }

        match /settings/{settingId} {
          allow read, write: if true;
        }

        // Site-scoped materials (used by the materials scope feature).
        match /materials/{materialId} {
          allow read, write: if true;
        }

        match /sessions/{sessionId} {
          allow read, write: if true;
        }

        // ─── Weighbridges ──────────────────────────────────────────

        match /weighbridges/{weighbridgeId} {
          allow read, write: if true;

          match /weighments/{weighmentId} {
            // Weighments are the billable/legal record. Clients create (incl. the
            // offline queue) and may edit, but must NOT delete — that's evidence
            // destruction. No client flow deletes weighments (verified).
            allow read, create, update: if true;
            allow delete: if false;
          }

          match /queues/{queueId} {
            allow read, write: if true;
          }

          match /counters/{counterId} {
            allow read, write: if true;
          }

          match /cameras/{cameraId} {
            allow read, write: if true;
          }

          match /gateEvents/{eventId} {
            allow read: if true;
            allow create: if true;
            allow update, delete: if false;
          }

          match /gateCommands/{commandId} {
            // Gate commands are CREATED only by triggerGate (server). Clients read
            // and mark status (update), but must not inject/delete commands —
            // direct creation = unauthorized physical gate actuation.
            allow read, update: if true;
            allow create, delete: if false;
          }

          match /settings/{settingId} {
            allow read, write: if true;
          }

          match /materials/{materialId} {
            allow read, write: if true;
          }

          match /print_log/{logId} {
            allow read, write: if true;
          }
        }
      }
    }

    // ─── Collection group queries (for cross-company lookups) ────────

    match /{path=**}/operators/{operatorId} {
      allow read: if true;
    }

    // ─── Legacy flat collections (migration period) ─────────────────

    match /operators/{operatorId} {
      allow read, create, delete: if true;
      allow update: if operatorUpdateSafe();
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /auditLog/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    match /notifications/{notifId} {
      allow read, write: if true;
    }

    match /customers/{customerId} {
      allow read, write: if true;
    }

    match /customers_deleted/{customerId} {
      allow read, write: if true;
    }

    match /customer_merges/{mergeId} {
      allow read, write: if true;
    }

    match /materials/{materialId} {
      allow read, write: if true;
    }

    match /vehicles/{vehicleId} {
      allow read, write: if true;
    }

    match /weighments/{weighmentId} {
      allow read, create, update: if true;
      allow delete: if false; // legal record — never client-deletable
    }

    match /queues/{queueId} {
      allow read, write: if true;
    }

    match /counters/{counterId} {
      allow read, write: if true;
    }

    match /cameras/{cameraId} {
      allow read, write: if true;
    }

    match /gateEvents/{eventId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    match /gateCommands/{commandId} {
      allow read, update: if true;
      allow create, delete: if false; // created only by triggerGate (server)
    }

    // ─── Server-only collections (Cloud Functions / Admin SDK only) ──────
    // Clients never access these directly; the Admin SDK bypasses rules, so
    // denying them here closes credential/license/OTP exposure and tampering.

    // Salted password credentials — must NEVER be client-readable.
    match /credentials/{id} {
      allow read, write: if false;
    }

    // Server-issued session tokens (loginUser mints; sensitive callables validate).
    match /auth_sessions/{token} {
      allow read, write: if false;
    }

    // Operator PIN hashes — server-only so the 4-6 digit PIN can't be brute-forced
    // offline. Set/verified via callables; the operator doc carries only `hasPin`.
    match /operator_pins/{id} {
      allow read, write: if false;
    }

    // Client crash/error reports — write-only mailbox: clients append, only the
    // server (console / functions) reads. No read/update/delete from clients.
    match /error_reports/{id} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Single-use password-reset tokens.
    match /password_reset_tokens/{id} {
      allow read, write: if false;
    }

    // License records (denormalized onto the company doc for client display).
    match /licenses/{licenseId} {
      allow read, write: if false;
    }

    // OTP hashes.
    match /verification_otps/{otpId} {
      allow read, write: if false;
    }

    // Per-(company, template) SMS alert throttle. Server-only — a client must not
    // be able to pre-write a cooldown doc to suppress security-alert SMS.
    match /notification_cooldowns/{id} {
      allow read, write: if false;
    }

    // Trial-abuse / GSTIN ownership registry. Client trial activation reads/writes
    // this directly (license_provider.activateTrial); kept open to match the
    // client-side license flow. (Re-lock to server-only when activateTrial is
    // migrated to a Cloud Function.)
    match /gstin_registry/{gstinId} {
      allow read, write: if true;
    }

    // Postal PIN-mailer queue — holds the plaintext code; server-only.
    match /mailers/{companyId} {
      allow read, write: if false;
    }

    // Address-verification status + 30-day deadline. Client may READ it (to
    // drive the grace gate) but only Cloud Functions may write it.
    match /address_verifications/{companyId} {
      allow read: if true;
      allow write: if false;
    }

    // App-version / auto-update feed — public read so clients can check for
    // updates; writes are server/admin-only (via deploy).
    match /global/app_version {
      allow read: if true;
      allow write: if false;
    }

    match /global/{docPath=**} {
      allow read, write: if false;
    }

    // GSTIN lookup cache (public GST data only — not sensitive).
    match /gstin_lookups/{lookupId} {
      allow read, write: if true;
    }
  }
}
