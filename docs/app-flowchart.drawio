        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="w_title" value="WEIGHMENT SESSION — COMPLETE 21-STEP FLOW" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontStyle=1;fontColor=#2D7B7B;" parent="1" vertex="1">
          <mxGeometry x="800" y="20" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="w_start" value="NEW SESSION&#xa;(F1/F2 or Button)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2D7B7B;fontColor=#ffffff;strokeColor=#1a5c5c;fontSize=13;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1050" y="80" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="w0" value="STEP 0: RETRY QUEUE [Automatic]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• Sync pending offline weighments before new session&#xa;• Types: weighments, audit, operator_updates, sessions&#xa;• Timeout: 10 seconds&#xa;• Can skip (auto-skip if online &amp; queue empty)&#xa;• Retry count tracked per item" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27AE60;fontColor=#ffffff;strokeColor=#1e8449;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="900" y="190" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ew0" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="w_start" target="w0" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w1" value="STEP 1: OPERATOR VERIFICATION [AI]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• Face verification of current operator&#xa;• Uses operator camera (configured in settings)&#xa;• Compares against enrolled face embeddings&#xa;• Confidence threshold check&#xa;• Timeout: 30 seconds&#xa;• Can skip (F8 to retry)&#xa;• Requires: operator camera + face model&#xa;• Logs: operator ID, confidence, timestamp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9B59B6;fontColor=#ffffff;strokeColor=#7d3c98;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="900" y="340" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ew1" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="w0" target="w1" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w2" value="STEP 2: CCTV / ANPR DETECTION [AI + Hardware]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• Automatic Number Plate Recognition&#xa;• Runs continuously until match or timeout&#xa;• Adaptive polling interval (faster when motion detected)&#xa;• Minimum votes threshold (configurable)&#xa;• Best candidate applied if timeout&#xa;• ANPR crop saved as evidence&#xa;• Bounding box overlay on camera feed&#xa;• Timeout: 60 seconds&#xa;• Can skip → manual vehicle number entry&#xa;• Confidence score logged&#xa;• Multiple camera support (best of N)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9B59B6;fontColor=#ffffff;strokeColor=#7d3c98;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="900" y="530" width="500" height="190" as="geometry" />
        </mxCell>
        <mxCell id="ew2" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="w1" target="w2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w3" value="STEP 3: WEIGHT CHECK [Hardware]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• Verify scale is near-zero (empty platform)&#xa;• OR verify weight is above threshold (vehicle present)&#xa;• Serial connection to indicator (RS-232/485)&#xa;• Timeout: 5 seconds&#xa;• Automatic (no user action needed)&#xa;• Checks scale health/connection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3498DB;fontColor=#ffffff;strokeColor=#2176a9;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="900" y="760" width="500" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ew3" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="w2" target="w3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w4" value="STEP 4: VEHICLE ENTRY [Hardware]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• Automatic gate open (if gate automation enabled)&#xa;• Traffic signal → GREEN&#xa;• F6 manual gate open&#xa;• Automatic — can skip&#xa;• Skipped if no gate controller configured" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3498DB;fontColor=#ffffff;strokeColor=#2176a9;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="900" y="920" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ew4" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="w3" target="w4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w5" value="STEP 5: STABILIZATION [Hardware + User]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• Wait for weight to stabilize on platform&#xa;• Live weight displayed in banner (real-time)&#xa;• Stability threshold: weight variance &lt; X kg for Y seconds&#xa;• Visual indicator: pulsing → stable&#xa;• Timeout: 60 seconds&#xa;• Manual trigger by operator (override)&#xa;• Requires: active scale connection&#xa;• Voice guidance: &#39;Vehicle detected, stabilizing...&#39;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F39C12;fontColor=#ffffff;strokeColor=#b87309;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="900" y="1070" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ew5" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="w4" target="w5" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w6" value="STEP 6: FIRST WEIGHT CAPTURE [User Action]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• Operator presses F5 or capture button&#xa;• Weight locked and stored with timestamp&#xa;• Snapshots taken from ALL configured cameras&#xa;• Camera crops saved (ANPR, wide, zoomed)&#xa;• First weigh type recorded: &#39;gross&#39; or &#39;tare&#39;&#xa;• Weight snapshot array populated&#xa;• Voice guidance: &#39;Weight captured: XX,XXX kg&#39;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F39C12;fontColor=#ffffff;strokeColor=#b87309;fontSize=11;align=left;spacingLeft=10;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="900" y="1260" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ew6" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="w5" target="w6" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w7" value="STEP 7: MATERIAL DETECTION [AI]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• Analyze vehicle/cargo for material type&#xa;• Uses camera snapshot + ML model&#xa;• Confidence score returned&#xa;• Suggest from configured materials list&#xa;• Can skip → manual material selection&#xa;• Training data collection (save for model improvement)&#xa;• Auto-apply if confidence &gt; threshold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9B59B6;fontColor=#ffffff;strokeColor=#7d3c98;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="900" y="1440" width="500" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ew7" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="w6" target="w7" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w8" value="STEP 8: CUSTOMER LOOKUP [User + Data]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• Search/select customer (F10)&#xa;• Auto-populate from face recognition&#xa;• Auto-populate from RFID tag match&#xa;• Auto-populate from vehicle history&#xa;• Create new customer inline&#xa;• Customer address, phone auto-filled&#xa;• Can skip&#xa;• Linked to customer master data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F39C12;fontColor=#ffffff;strokeColor=#b87309;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="900" y="1610" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ew8" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="w7" target="w8" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w9" value="STEP 9: DRIVER / CUSTOMER FACE ASSIST [AI]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• Face verification of driver/customer&#xa;• Uses customer camera&#xa;• Compare against customer DB embeddings&#xa;• Confidence threshold for auto-match&#xa;• Can skip if disabled&#xa;• F9 to retry&#xa;• Enrollment option for new faces&#xa;• Links face to customer record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9B59B6;fontColor=#ffffff;strokeColor=#7d3c98;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="900" y="1800" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ew9" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="w8" target="w9" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w_await" value="SESSION STATUS: awaitingSecondWeight&#xa;Vehicle leaves platform → returns for 2nd weighing&#xa;(Could be hours/days later — session persisted to disk)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#95A5A6;fontColor=#ffffff;strokeColor=#717d7e;fontSize=11;align=center;fontStyle=2;" parent="1" vertex="1">
          <mxGeometry x="900" y="1990" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ew_await" style="edgeStyle=orthogonalEdgeStyle;dashed=1;" parent="1" source="w9" target="w_await" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w10" value="STEP 10: SECOND WEIGHT CAPTURE [User Action]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• Vehicle returns to platform&#xa;• Stabilize again (same logic as step 5)&#xa;• Operator presses F5 to capture&#xa;• Timeout: 60 seconds&#xa;• Snapshots taken again (all cameras)&#xa;• GROSS / TARE / NET auto-calculated:&#xa;  ├─ If first was loaded: first=gross, second=tare&#xa;  └─ If first was empty: first=tare, second=gross&#xa;  └─ NET = |gross - tare|&#xa;• Voice guidance: &#39;Net weight: XX,XXX kg&#39;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F39C12;fontColor=#ffffff;strokeColor=#b87309;fontSize=11;align=left;spacingLeft=10;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="900" y="2090" width="500" height="180" as="geometry" />
        </mxCell>
        <mxCell id="ew10" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="w_await" target="w10" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w11" value="STEP 11: RST ASSIGNMENT [Automatic]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• Assign Road Tax Stamp number&#xa;• Auto-increment from last used&#xa;• Manual override available&#xa;• Unique per site per day&#xa;• Format configurable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4DB8B8;fontColor=#ffffff;strokeColor=#2D7B7B;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="900" y="2310" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ew11" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="w10" target="w11" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w12" value="STEP 12: SAVE TO FIRESTORE [Automatic]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• Upload complete weighment document&#xa;• Path: companies/{id}/sites/{id}/weighments/{id}&#xa;• All data: weights, snapshots, AI predictions, customer, material&#xa;• Retry queue if offline (queued with timestamp)&#xa;• Audit trail entry created&#xa;• Operator session logged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27AE60;fontColor=#ffffff;strokeColor=#1e8449;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="900" y="2460" width="500" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ew12" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="w11" target="w12" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w13" value="STEP 13: GENERATE DOCKET PDF [Automatic]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• Create docket PDF with all weighment data&#xa;• Embed camera snapshots&#xa;• Company logo + header&#xa;• Custom fields included&#xa;• QR code for verification&#xa;• Can skip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4DB8B8;fontColor=#ffffff;strokeColor=#2D7B7B;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="900" y="2620" width="500" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ew13" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="w12" target="w13" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w14" value="STEP 14: PRINT DOCKET [User Action]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• Send PDF to configured printer&#xa;• ESC/POS thermal or standard printer&#xa;• F4 shortcut&#xa;• Can skip&#xa;• Print count tracked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F39C12;fontColor=#ffffff;strokeColor=#b87309;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="900" y="2780" width="500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ew14" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="w13" target="w14" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w15" value="STEP 15: PRINT STICKER [User Action]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• Print weight sticker (small label)&#xa;• Vehicle number + net weight + date&#xa;• F11 shortcut&#xa;• Can skip&#xa;• Separate printer config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F39C12;fontColor=#ffffff;strokeColor=#b87309;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="900" y="2920" width="500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ew15" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="w14" target="w15" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w16" value="STEP 16: GOOGLE SHEETS SYNC [Automatic]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• Sync weighment to configured Google Sheet&#xa;• Append row with all fields&#xa;• Uses Sheets API (OAuth)&#xa;• Can skip&#xa;• Skipped if integration not enabled&#xa;• Retry on failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27AE60;fontColor=#ffffff;strokeColor=#1e8449;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="900" y="3060" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ew16" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="w15" target="w16" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w17" value="STEP 17: WHATSAPP NOTIFICATION [Automatic]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• Send docket via WhatsApp to customer&#xa;• Uses WhatsApp Business API&#xa;• PDF attachment + summary text&#xa;• Can skip&#xa;• Skipped if integration not enabled&#xa;• Customer phone required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27AE60;fontColor=#ffffff;strokeColor=#1e8449;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="900" y="3210" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ew17" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="w16" target="w17" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w18" value="STEP 18: VEHICLE EXIT [Hardware]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• Automatic exit gate open&#xa;• Traffic signal → GREEN (exit)&#xa;• F7 manual gate close after exit&#xa;• Can skip&#xa;• Skipped if no gate controller&#xa;• Auto-close timer (configurable delay)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3498DB;fontColor=#ffffff;strokeColor=#2176a9;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="900" y="3360" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ew18" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="w17" target="w18" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w_end" value="SESSION COMPLETE&#xa;Status: completed&#xa;Ready for next vehicle" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2D7B7B;fontColor=#ffffff;strokeColor=#1a5c5c;fontSize=13;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1025" y="3520" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ew_end" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="w18" target="w_end" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w_keys" value="KEYBOARD SHORTCUTS&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;F1 / F2  — New Weighment&#xa;F3       — Manual Entry Mode&#xa;F4       — Save / Print (context-aware)&#xa;F5       — Capture Weight&#xa;F6       — Open Gate&#xa;F7       — Close Gate&#xa;F8       — Retry Operator Verify&#xa;F9       — Retry Customer Verify&#xa;F10      — Customer Search&#xa;F11      — Print Slip&#xa;Esc      — Cancel / Back" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#95A5A6;fontColor=#ffffff;strokeColor=#717d7e;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="100" y="200" width="350" height="250" as="geometry" />
        </mxCell>
        <mxCell id="w_model" value="WEIGHMENT SESSION DATA MODEL&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;Identity:&#xa;  • UUID, started_at, status, elapsed&#xa;  • Status: active → awaitingSecondWeight → completed → cancelled&#xa;&#xa;Vehicle:&#xa;  • Number (ANPR or manual), RFID tag&#xa;  • Direction: inbound / outbound&#xa;&#xa;Customer:&#xa;  • Name, address, phone&#xa;  • Face embedding / customer ID&#xa;&#xa;Material:&#xa;  • Type (AI or manual), direction&#xa;&#xa;Weights:&#xa;  • First weight + timestamp&#xa;  • Second weight + timestamp&#xa;  • Gross / Tare / Net (calculated)&#xa;  • Weight snapshots (per camera)&#xa;  • First weigh type: &#39;gross&#39; or &#39;tare&#39;&#xa;&#xa;AI Predictions:&#xa;  • ANPR: plate + confidence + crop&#xa;  • Material: type + confidence&#xa;  • Driver face: embedding&#xa;  • Customer face: embedding + ID&#xa;  • Training data flag&#xa;&#xa;Post-Weighment:&#xa;  • RST number&#xa;  • Docket PDF generated&#xa;  • Sticker printed&#xa;  • Sheets sync status&#xa;  • WhatsApp sent status&#xa;  • Completed_at timestamp&#xa;&#xa;Custom Fields:&#xa;  • Site-specific key-value pairs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2D7B7B;fontColor=#ffffff;strokeColor=#1a5c5c;fontSize=10;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="100" y="500" width="350" height="620" as="geometry" />
        </mxCell>
        <mxCell id="w_ui" value="WEIGHMENT SCREEN UI COMPONENTS&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;┌─────────────────────────────────────┐&#xa;│ LIVE WEIGHT BANNER (real-time)      │&#xa;│ Shows: current kg, stability, unit  │&#xa;├─────────────────────────────────────┤&#xa;│ PHASE STEPPER (visual progress)     │&#xa;│ Shows: current step, completed, next│&#xa;├──────────────┬──────────────────────┤&#xa;│ LEFT PANEL   │  RIGHT PANEL         │&#xa;│              │                      │&#xa;│ Vehicle form │  Camera carousel     │&#xa;│ Material sel │  ANPR crops          │&#xa;│ Customer sel │  Identity cameras    │&#xa;│ Custom fields│  Weighbridge cams    │&#xa;│              │  Pending queue       │&#xa;├──────────────┴──────────────────────┤&#xa;│ ACTION BAR (F-key shortcuts)        │&#xa;│ STATUS BAR (connection, sync)       │&#xa;└─────────────────────────────────────┘&#xa;&#xa;Overlays:&#xa;• AI confirmation dialogs&#xa;• PIN entry banner (if security on)&#xa;• ANPR bounding box overlay&#xa;• Face verification overlay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4DB8B8;fontColor=#ffffff;strokeColor=#2D7B7B;fontSize=10;align=left;spacingLeft=10;fontFamily=Courier New;" parent="1" vertex="1">
          <mxGeometry x="100" y="1170" width="380" height="470" as="geometry" />
        </mxCell>
        <mxCell id="w_cancel" value="CANCEL / ERROR HANDLING&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;Esc key → Cancel confirmation dialog&#xa;  • Discard session (no save)&#xa;  • Status: cancelled&#xa;&#xa;Offline during save:&#xa;  • Queue to retry queue&#xa;  • Continue to next steps&#xa;  • Sync when back online&#xa;&#xa;Scale disconnection:&#xa;  • Show error in status bar&#xa;  • Block weight capture&#xa;  • Auto-reconnect attempts&#xa;&#xa;Camera failure:&#xa;  • Skip snapshot gracefully&#xa;  • Log camera error&#xa;  • Continue flow (non-blocking)&#xa;&#xa;AI timeout:&#xa;  • Apply best candidate if any&#xa;  • Skip if no candidate&#xa;  • Manual entry fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E74C3C;fontColor=#ffffff;strokeColor=#a93226;fontSize=10;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="100" y="1690" width="380" height="400" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
