        <mxCell id="opt_header" value="OPTIONAL STEPS (Admin Only, with Navigation Bar)" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#3498DB;" parent="1" vertex="1">
          <mxGeometry x="800" y="1290" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="STEP 7: SCALE CONFIGURATION [Admin, Optional]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• RS-232 / RS-485 connection type&#xa;• COM port selection&#xa;• Baud rate, parity, stop bits&#xa;• Indicator model (make + model)&#xa;• Test connection / live reading&#xa;• Navigation bar (skip/next)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3498DB;fontColor=#ffffff;strokeColor=#2176a9;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="400" y="1330" width="380" height="130" as="geometry" />
