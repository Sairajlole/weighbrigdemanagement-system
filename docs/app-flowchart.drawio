        <mxCell id="es13a" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="s12" target="s13" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="es13o" value="Operator (skip optional)" style="edgeStyle=orthogonalEdgeStyle;fontColor=#9B59B6;fontSize=10;dashed=1;" parent="1" source="s6_dec" target="s13" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1350" y="1090" />
              <mxPoint x="1350" y="2415" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="s_complete" value="SETUP COMPLETE&#xa;Site marked configured&#xa;→ Redirect to /dashboard" style="ellipse;whiteSpace=wrap;html=1;fillColor=#27AE60;fontColor=#ffffff;strokeColor=#1e8449;fontSize=12;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1050" y="2530" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es_complete" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="s13" target="s_complete" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s_persist" value="PERSISTENCE&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• Progress saved to disk (SharedPreferences)&#xa;• Current step index persisted&#xa;• Role &amp; tier persisted&#xa;• Resumable on app restart&#xa;• Sidebar shows step progress&#xa;• Steps can be revisited (back button)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#95A5A6;fontColor=#ffffff;strokeColor=#717d7e;fontSize=10;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="1550" y="1000" width="350" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s_sidebar_note" value="WIZARD SIDEBAR&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• Step list with completion status&#xa;• Current step highlighted&#xa;• Role-filtered (only shows visible steps)&#xa;• Tier-filtered (pro steps hidden on free)&#xa;• Click to navigate (completed steps only)&#xa;• Progress percentage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#95A5A6;fontColor=#ffffff;strokeColor=#717d7e;fontSize=10;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="1550" y="1160" width="350" height="120" as="geometry" />
        </mxCell>
