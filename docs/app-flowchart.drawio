        <mxCell id="flow1" value="WEIGHMENT DATA PIPELINE:&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;&#xa;[Scale] ──weight──▶ [App State Machine] ──capture──▶ [Local Session JSON] ──save──▶ [Firestore]&#xa;                                                                                      │&#xa;[Cameras] ──snap──▶ [AI Sidecar] ──predict──▶ [App State] ──store──▶ [Session] ──────────┤&#xa;                                                                                      │&#xa;[RFID] ──tag──▶ [Customer Lookup] ──match──▶ [Auto-fill form]                            │&#xa;                                                                                      ▼&#xa;                                                                              [Cloud Functions]&#xa;                                                                                      │&#xa;                                                                    ┌─────────┬────────┼────────┐&#xa;                                                                    ▼         ▼        ▼        ▼&#xa;                                                              [G.Sheets] [WhatsApp] [Tally] [Webhook]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2D7B7B;fontColor=#ffffff;strokeColor=#1a5c5c;fontSize=10;align=left;spacingLeft=10;fontFamily=Courier New;" parent="flow_group" vertex="1">
