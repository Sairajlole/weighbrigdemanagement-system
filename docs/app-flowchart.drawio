        <mxCell id="s3" value="STEP 3: ACCOUNT [Both Roles]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• Email address&#xa;• Password + confirmation&#xa;• Document upload (Aadhaar/PAN/Passport)&#xa;• Profile photo (base64 capture)&#xa;• Self-contained navigation&#xa;• REQUIRED step" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4DB8B8;fontColor=#ffffff;strokeColor=#2D7B7B;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
