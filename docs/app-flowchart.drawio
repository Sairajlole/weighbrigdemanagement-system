        <mxCell id="sec2" value="Shift-Based Login Restriction&#xa;• Operators can only log in during assigned shifts&#xa;• Auto-logout at shift end" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E74C3C;fontColor=#ffffff;strokeColor=#a93226;fontSize=10;align=left;spacingLeft=10;" parent="sec_group" vertex="1">
