        </mxCell>
        <mxCell id="s9_note" value="⚠ Hidden if Free tier" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#E74C3C;fontStyle=2;" parent="1" vertex="1">
          <mxGeometry x="790" y="1710" width="140" height="20" as="geometry" />
        </mxCell>
        <mxCell id="s10" value="STEP 10: CAMERAS [Admin, Optional]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• IP camera setup (RTSP URL)&#xa;• Camera types: ANPR, CCTV, Operator, Customer&#xa;• Camera naming &amp; positioning&#xa;• Test stream preview&#xa;• Navigation bar (skip/next)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3498DB;fontColor=#ffffff;strokeColor=#2176a9;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="400" y="1830" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="es10" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="s9" target="s10" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s11" value="STEP 11: PRINTING [Admin, Optional]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• Docket printer setup&#xa;• Thermal printer models (ESC/POS)&#xa;• Sticker printer config&#xa;• Paper size, margins&#xa;• Test print&#xa;• Navigation bar (skip/next)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3498DB;fontColor=#ffffff;strokeColor=#2176a9;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="400" y="1990" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="es11" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="s10" target="s11" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s12" value="STEP 12: SECURITY [Admin, Optional]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• MFA settings (SMS/email)&#xa;• Role-based access control&#xa;• IP whitelist (CIDR rules)&#xa;• Session timeout&#xa;• Password policies&#xa;• Navigation bar (skip/next)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9B59B6;fontColor=#ffffff;strokeColor=#7d3c98;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="400" y="2150" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="es12" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="s11" target="s12" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s13" value="STEP 13: REVIEW &amp; COMPLETE [Both Roles]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• Summary of ALL configuration&#xa;• Review company info, account, hardware&#xa;• Final confirmation button&#xa;• Submit → mark site as configured&#xa;• Self-contained navigation&#xa;• REQUIRED step" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2D7B7B;fontColor=#ffffff;strokeColor=#1a5c5c;fontSize=11;align=left;spacingLeft=10;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="975" y="2350" width="380" height="130" as="geometry" />
