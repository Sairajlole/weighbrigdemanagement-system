        <mxCell id="sec4" value="Audit Trail Logging&#xa;• Every weighment, login, config change logged&#xa;• Tamper-evident (Firestore server timestamps)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E74C3C;fontColor=#ffffff;strokeColor=#a93226;fontSize=10;align=left;spacingLeft=10;" parent="sec_group" vertex="1">
          <mxGeometry x="20" y="225" width="460" height="45" as="geometry" />
