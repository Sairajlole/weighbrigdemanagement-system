        <mxCell id="sec5" value="Emergency Lockdown&#xa;• Admin triggers via Cloud Function&#xa;• ALL users redirected to /lockdown&#xa;• No weighments possible until lifted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E74C3C;fontColor=#ffffff;strokeColor=#a93226;fontSize=10;align=left;spacingLeft=10;" parent="sec_group" vertex="1">
