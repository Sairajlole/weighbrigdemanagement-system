        <mxCell id="es7" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="s_tier" target="s7" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="STEP 8: MATERIALS [Admin, Optional]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• Add products handled at site&#xa;• Categories &amp; descriptions&#xa;• Unit of measurement&#xa;• Used in weighment material detection&#xa;• Navigation bar (skip/next)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3498DB;fontColor=#ffffff;strokeColor=#2176a9;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="400" y="1500" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="es8" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="s7" target="s8" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="STEP 9: GATES [Admin, PRO/TRIAL Only, Optional]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• Configure entry/exit gates&#xa;• Gate controller type (Modbus/proprietary)&#xa;• RFID reader setup (Wiegand protocol)&#xa;• Gate automation rules&#xa;• minimumTier: trial&#xa;• Navigation bar (skip/next)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9B59B6;fontColor=#ffffff;strokeColor=#7d3c98;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="400" y="1660" width="380" height="130" as="geometry" />
