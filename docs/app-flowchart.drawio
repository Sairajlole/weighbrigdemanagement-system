        <mxCell id="s6" value="STEP 6: LICENSE [Admin Only]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• Choose plan: Free / Trial (30d) / Pro&#xa;• Tier determines feature visibility&#xa;• Affects subsequent wizard steps&#xa;• REQUIRED (admin)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2D7B7B;fontColor=#ffffff;strokeColor=#1a5c5c;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
